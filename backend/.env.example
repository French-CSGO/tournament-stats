PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=get5
DB_PASS=yourpassword
DB_NAME=get5

# Token used by G5API to authenticate demo uploads
DEMO_UPLOAD_TOKEN=changeme

# Base URL used in download links returned to G5API
PUBLIC_URL=https://stats.yourdomain.com

# Code d'accès à la page admin
ADMIN_CODE=changeme

# Clé API Challonge : stockée en BDD dans settings (setting_key = 'challonge.apiKey')
# ou définie ici (prioritaire sur la valeur en BDD si renseignée)
CHALLONGE_API_KEY=

# Clé API "interne" utilisée par le frontend pour appeler /api/* (toutes les
# routes /api/* sauf /api/demos exigent une clé API — voir /api/docs).
# Cette même valeur doit être définie sur le conteneur frontend (voir
# frontend/nginx.conf.template) afin que Nginx l'injecte côté serveur — le
# navigateur ne la voit jamais. Le backend la seed automatiquement au
# démarrage comme une clé API normale (révocable depuis la page Admin).
INTERNAL_API_KEY=changeme

# Quota de requêtes/minute accordé à la clé interne du frontend (élevé par défaut)
INTERNAL_API_KEY_RATE_LIMIT=6000
