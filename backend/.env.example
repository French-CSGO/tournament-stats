PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=get5
DB_PASS=yourpassword
DB_NAME=get5

# Token used by G5API to authenticate demo uploads
DEMO_UPLOAD_TOKEN=changeme

# Base URL used in download links returned to G5API
PUBLIC_URL=https://stats.yourdomain.com

# Code d'accès à la page admin
ADMIN_CODE=changeme

# Clé API Challonge : stockée en BDD dans settings (setting_key = 'challonge.apiKey')
# ou définie ici (prioritaire sur la valeur en BDD si renseignée)
CHALLONGE_API_KEY=

# Toutes les routes /api/* (sauf /api/demos) exigent une clé API — voir /api/docs.
# Ce backend ne stocke aucune clé lui-même (la BDD get5 peut être une réplique
# en lecture seule) : il réutilise les clés déjà émises par G5API, stockées
# chiffrées dans user.api_key. G5API_DB_KEY DOIT être identique à la valeur
# DBKEY/server.dbKey configurée côté G5API, sinon aucune clé ne pourra être
# déchiffrée/validée.
G5API_DB_KEY=

# Quota de requêtes/minute par clé API "utilisateur G5API"
API_KEY_RATE_LIMIT_PER_MIN=60

# Clé API "interne" utilisée par le frontend pour appeler /api/* — un simple
# secret partagé (pas une clé G5API), comparé directement, jamais stocké en
# BDD. Cette même valeur doit être définie sur le conteneur frontend (voir
# frontend/nginx.conf.template) afin que Nginx l'injecte côté serveur — le
# navigateur ne la voit jamais.
INTERNAL_API_KEY=changeme
INTERNAL_API_KEY_RATE_LIMIT=6000
