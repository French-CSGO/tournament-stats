# Base URL of your G5V instance (used for map images in veto display)
# Leave empty if G5V is served on the same host
VITE_G5V_URL=https://ebot.yourdomain.com

# Must match backend's INTERNAL_API_KEY — injected server-side by the Vite
# dev proxy (and by Nginx in production) so the browser never sees it.
INTERNAL_API_KEY=changeme
