server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Archives ZIP de démos : streamées directement (pas de buffer disque nginx)
    location ~ ^/api/seasons/[0-9]+/demos/archive {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Api-Key "${INTERNAL_API_KEY}";
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Api-Key "${INTERNAL_API_KEY}";
        client_max_body_size 500m;
    }

    location /demos/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/demos/;
    }
}
